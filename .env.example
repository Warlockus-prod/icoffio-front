# 🔑 ICOFFIO ENVIRONMENT VARIABLES
# Скопируйте этот файл в .env.local и заполните реальными ключами

# ========== ОБЯЗАТЕЛЬНЫЕ ДЛЯ РАБОТЫ AI ФУНКЦИЙ ==========
# OpenAI API Key - получите на https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ========== WORDPRESS ИНТЕГРАЦИЯ ==========
# WORDPRESS_API_URL=https://icoffio.com
# WORDPRESS_USERNAME=your-username
# WORDPRESS_APP_PASSWORD=your-app-password

# ========== N8N ИНТЕГРАЦИЯ ==========
# N8N_WEBHOOK_SECRET=your-secure-secret

# ========== ОСНОВНЫЕ НАСТРОЙКИ ==========
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ========== DATABASE (SELF-HOSTED POSTGRESQL) ==========
# Required for article storage, Telegram pipeline, analytics and admin APIs.
# Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/icoffio?sslmode=disable
# DATABASE_URL=
# POSTGRES_USER=icoffio
# POSTGRES_DB=icoffio
# POSTGRES_PASSWORD=change-me

# ========== LEGACY SUPABASE (DEPRECATED) ==========
# Left only for old scripts/docs compatibility. Runtime API uses DATABASE_URL.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional bootstrap list for first admin login (comma-separated)
# ADMIN_BOOTSTRAP_EMAILS=owner@icoffio.com,admin@icoffio.com

# Optional self-signup mode for admin panel login page.
# When enabled, unknown emails can be auto-created with default role (viewer/editor).
# ADMIN_SELF_SIGNUP_ENABLED=false
# ADMIN_SELF_SIGNUP_DEFAULT_ROLE=viewer

# Immutable owner emails (primary + backup)
# If omitted, defaults are used in code:
# - ag@voxexchange.io
# - andrzej.goleta@hybrid.ai
# ADMIN_OWNER_EMAILS=ag@voxexchange.io,andrzej.goleta@hybrid.ai

# ========== ДОПОЛНИТЕЛЬНЫЕ (ОПЦИОНАЛЬНО) ==========
# UNSPLASH_ACCESS_KEY=your-unsplash-key
# TELEGRAM_BOT_TOKEN=your-bot-token
