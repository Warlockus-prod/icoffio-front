{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "@next/next/no-img-element": "warn",
    "react/no-unescaped-entities": "off",
    "react-hooks/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      "files": [
        "components/admin/**",
        "app/[locale]/admin/**"
      ],
      "rules": {
        "@next/next/no-img-element": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "build/",
    "scripts/",
    "*.config.mjs",
    "*.config.js",
    "*.config.ts",
    "supabase/"
  ]
}
